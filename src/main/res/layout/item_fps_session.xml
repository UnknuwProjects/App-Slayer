<?xml version="1.0" encoding="utf-8"?>
<!-- One recorded FPS session in the list: the same card look as
the rest of the app, app name over a muted line with the date,
duration and average FPS. Filled in by FpsSessionsActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@drawable/card_background" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:id="@+id/sessionRowTitle" android:textSize="16sp" android:textStyle="bold" android:textColor="#ffffff" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/sessionRowSubtitle" android:textSize="13sp" android:textColor="#9aa0a6" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"/>
</LinearLayout>
