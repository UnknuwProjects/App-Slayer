<?xml version="1.0" encoding="utf-8"?>
<!-- Floating Monitor screen in the app's card design language
(6.3.9): every section is a card on the shared #111111 panel —
Diagnostik with label/value rows and app-style buttons, the
Battery Status entry as a card row, Riwayat Baterai, Sensor Suhu,
Setelan, Gaya Monitor, Monitor and Perekam FPS as cards, and the
reset as a quiet red text button. Presentation only: every view
id, handler and pref key is exactly what it was before. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:background="#000000" android:padding="16dp" android:fitsSystemWindows="true" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:id="@+id/monitorContainer" android:background="#111111" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="vertical" android:background="@drawable/card_background" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="#448aff" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/diag_title"/>
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp">
                <TextView android:textSize="14sp" android:textColor="#9aa0a6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/diag_label_permission"/>
                <TextView android:id="@+id/diagPermission" android:textSize="14sp" android:textColor="#ffffff" android:gravity="end" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp">
                <TextView android:textSize="14sp" android:textColor="#9aa0a6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/diag_label_service"/>
                <TextView android:id="@+id/diagService" android:textSize="14sp" android:textColor="#ffffff" android:gravity="end" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp">
                <TextView android:textSize="14sp" android:textColor="#9aa0a6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/diag_label_windows"/>
                <TextView android:id="@+id/diagWindows" android:textSize="14sp" android:textColor="#ffffff" android:gravity="end" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp">
                <TextView android:textSize="14sp" android:textColor="#9aa0a6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/diag_label_enabled_service"/>
                <TextView android:id="@+id/diagEnabledService" android:textSize="14sp" android:textColor="#ffffff" android:gravity="end" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp">
                <TextView android:textSize="14sp" android:textColor="#9aa0a6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/diag_label_last_add"/>
                <TextView android:id="@+id/diagLastAdd" android:textSize="14sp" android:textColor="#ffffff" android:gravity="end" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp">
                <TextView android:textSize="14sp" android:textColor="#9aa0a6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/diag_label_notif_permission"/>
                <TextView android:id="@+id/diagNotifPermission" android:textSize="14sp" android:textColor="#ffffff" android:gravity="end" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:textSize="14sp" android:textColor="#9aa0a6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/diag_label_notif_service"/>
                <TextView android:id="@+id/diagNotifService" android:textSize="14sp" android:textColor="#ffffff" android:gravity="end" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
                <Button android:textSize="14sp" android:textColor="#ffffff" android:textAllCaps="false" android:background="@drawable/btn_card" android:id="@+id/btnTestOverlay" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginEnd="8dp" android:text="@string/diag_test"/>
                <Button android:textSize="14sp" android:textColor="#ffffff" android:textAllCaps="false" android:background="@drawable/btn_card" android:id="@+id/btnTestFunctions" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:text="@string/btn_test_functions"/>
            </LinearLayout>
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                <Button android:textSize="13sp" android:textColor="#ffffff" android:textAllCaps="false" android:background="@drawable/btn_card" android:id="@+id/btnRunChecks" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginEnd="8dp" android:text="@string/diag_run_checks"/>
                <Button android:textSize="13sp" android:textColor="#ffffff" android:textAllCaps="false" android:background="@drawable/btn_card" android:id="@+id/btnShareLog" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginEnd="8dp" android:text="@string/diag_share_log"/>
                <Button android:textSize="13sp" android:textColor="#ffffff" android:textAllCaps="false" android:background="@drawable/btn_card" android:id="@+id/btnClearLog" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:text="@string/diag_clear_log"/>
            </LinearLayout>
            <TextView android:id="@+id/diagLogPathHint" android:textSize="12sp" android:textColor="#9aa0a6" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/diag_log_path_hint"/>
        </LinearLayout>
        <Button android:textSize="16sp" android:textColor="#ffffff" android:textAllCaps="false" android:background="@drawable/card_background" android:drawableStart="@drawable/ic_battery" android:drawableEnd="@drawable/ic_chevron" android:drawablePadding="10dp" android:gravity="start|center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:id="@+id/btnBatteryStatus" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:text="@string/battery_status"/>
        <LinearLayout android:orientation="vertical" android:background="@drawable/card_background" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/battery_history_title" android:textSize="16sp" android:textStyle="bold" android:textColor="#448aff"/>
            <com.appslayer.official.BatteryGraphView android:id="@+id/batteryGraph" android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="8dp"/>
            <TextView android:id="@+id/batteryHistorySummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp" android:textColor="#9aa0a6"/>
            <LinearLayout android:id="@+id/batteryHistoryRows" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp">
                    <TextView android:textSize="14sp" android:textColor="#9aa0a6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/since_last_full_charge"/>
                    <TextView android:id="@+id/batteryHistorySinceValue" android:textSize="14sp" android:textColor="#ffffff" android:gravity="end" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp">
                    <TextView android:textSize="14sp" android:textColor="#9aa0a6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/avg_drain"/>
                    <TextView android:id="@+id/batteryHistoryDrainValue" android:textSize="14sp" android:textColor="#ffffff" android:gravity="end" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/batteryHistoryLeftRow" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:textSize="14sp" android:textColor="#9aa0a6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/estimated_time_left"/>
                    <TextView android:id="@+id/batteryHistoryLeftValue" android:textSize="14sp" android:textColor="#ffffff" android:gravity="end" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/batteryHistoryHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="13sp" android:textColor="#ffb300" android:text="@string/battery_history_hint" android:visibility="gone"/>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:background="@drawable/card_background" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/temp_sensors_title" android:textSize="16sp" android:textStyle="bold" android:textColor="#448aff"/>
            <TextView android:id="@+id/tempThermalStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="14sp" android:textColor="#ffffff"/>
            <TextView android:id="@+id/tempSensorList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="13sp" android:textColor="#9aa0a6"/>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:background="@drawable/card_background" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="#448aff" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/settings_title"/>
            <TextView android:textSize="16sp" android:textColor="#ffffff" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/transparency"/>
            <SeekBar android:id="@+id/seekTransparency" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:textSize="16sp" android:textColor="#ffffff" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/text_size"/>
            <SeekBar android:id="@+id/seekTextSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"/>
            <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchSnapToBar" android:showText="false" android:thumbTint="@color/switch_thumb_tint" android:trackTint="@color/switch_track_tint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="@string/snap_to_bar"/>
            <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchClickThrough" android:showText="false" android:thumbTint="@color/switch_thumb_tint" android:trackTint="@color/switch_track_tint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="@string/click_through"/>
            <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchFullscreen" android:showText="false" android:thumbTint="@color/switch_thumb_tint" android:trackTint="@color/switch_track_tint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="@string/disable_fullscreen"/>
            <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchLandscape" android:showText="false" android:thumbTint="@color/switch_thumb_tint" android:trackTint="@color/switch_track_tint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="@string/disable_landscape"/>
            <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchDarkText" android:showText="false" android:thumbTint="@color/switch_thumb_tint" android:trackTint="@color/switch_track_tint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="@string/dark_text"/>
            <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchTextShadow" android:showText="false" android:thumbTint="@color/switch_thumb_tint" android:trackTint="@color/switch_track_tint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="@string/text_shadow"/>
            <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchBoot" android:showText="false" android:thumbTint="@color/switch_thumb_tint" android:trackTint="@color/switch_track_tint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/start_on_boot"/>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:background="@drawable/card_background" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="#448aff" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/monitor_style_title"/>
            <RadioGroup android:id="@+id/radioMonitorStyle" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                <RadioButton android:id="@+id/radioStyleClassic" android:textSize="16sp" android:textColor="#ffffff" android:buttonTint="@color/radio_tint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="24dp" android:text="@string/monitor_style_classic"/>
                <RadioButton android:id="@+id/radioStyleMini" android:textSize="16sp" android:textColor="#ffffff" android:buttonTint="@color/radio_tint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/monitor_style_mini"/>
            </RadioGroup>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:background="@drawable/card_background" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="#448aff" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/monitor_title"/>
            <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchCpu" android:showText="false" android:thumbTint="@color/switch_thumb_tint" android:trackTint="@color/switch_track_tint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="@string/monitor_cpu"/>
            <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchTemp" android:showText="false" android:thumbTint="@color/switch_thumb_tint" android:trackTint="@color/switch_track_tint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="@string/monitor_temp"/>
            <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchBattery" android:showText="false" android:thumbTint="@color/switch_thumb_tint" android:trackTint="@color/switch_track_tint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="@string/monitor_battery"/>
            <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchRam" android:showText="false" android:thumbTint="@color/switch_thumb_tint" android:trackTint="@color/switch_track_tint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="@string/monitor_ram"/>
            <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchBatteryCurrent" android:showText="false" android:thumbTint="@color/switch_thumb_tint" android:trackTint="@color/switch_track_tint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="@string/monitor_current"/>
            <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchSignal" android:showText="false" android:thumbTint="@color/switch_thumb_tint" android:trackTint="@color/switch_track_tint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="@string/monitor_signal"/>
            <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchFps" android:showText="false" android:thumbTint="@color/switch_thumb_tint" android:trackTint="@color/switch_track_tint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="@string/monitor_fps"/>
            <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchProcess" android:showText="false" android:thumbTint="@color/switch_thumb_tint" android:trackTint="@color/switch_track_tint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/monitor_process"/>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:background="@drawable/card_background" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="#448aff" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/fps_record_title"/>
            <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchRecordFps" android:showText="false" android:thumbTint="@color/switch_thumb_tint" android:trackTint="@color/switch_track_tint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/record_fps"/>
            <TextView android:id="@+id/recordFpsStatus" android:textSize="13sp" android:textColor="#ffffff" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
            <TextView android:textSize="13sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:textColor="#9aa0a6" android:text="@string/record_fps_hint"/>
            <Button android:textSize="15sp" android:textColor="#ffffff" android:textAllCaps="false" android:background="@drawable/btn_card" android:id="@+id/btnFpsSessions" android:layout_width="match_parent" android:layout_height="44dp" android:text="@string/btn_fps_sessions"/>
        </LinearLayout>
        <Button android:textSize="15sp" android:textColor="#ef5350" android:textAllCaps="false" android:background="@android:color/transparent" android:layout_gravity="center_horizontal" android:id="@+id/buttonReset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" android:text="@string/reset_settings"/>
    </LinearLayout>
</ScrollView>
