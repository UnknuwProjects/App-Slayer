<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:background="#000000" android:padding="16dp" android:fitsSystemWindows="true" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:id="@+id/monitorContainer" android:background="#111111" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="#448aff" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/diag_title"/>
        <TextView android:id="@+id/diagPermission" android:textSize="14sp" android:textColor="#ffffff" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/diagService" android:textSize="14sp" android:textColor="#ffffff" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/diagWindows" android:textSize="14sp" android:textColor="#ffffff" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/diagEnabledService" android:textSize="14sp" android:textColor="#ffffff" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/diagLastAdd" android:textSize="14sp" android:textColor="#ffffff" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/diagNotifPermission" android:textSize="14sp" android:textColor="#ffffff" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/diagNotifService" android:textSize="14sp" android:textColor="#ffffff" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
        <Button android:textSize="14sp" android:id="@+id/btnTestOverlay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/diag_test"/>
        <Button android:textSize="14sp" android:id="@+id/btnTestFunctions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/btn_test_functions"/>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp">
            <Button android:textSize="13sp" android:id="@+id/btnRunChecks" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/diag_run_checks"/>
            <Button android:textSize="13sp" android:id="@+id/btnShareLog" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/diag_share_log"/>
            <Button android:textSize="13sp" android:id="@+id/btnClearLog" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/diag_clear_log"/>
        </LinearLayout>
        <TextView android:id="@+id/diagLogPathHint" android:textSize="12sp" android:textColor="#9aa0a6" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/diag_log_path_hint"/>
        <Button android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/btnBatteryStatus" android:background="#880e4f" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/battery_status"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/battery_history_title" android:textSize="16sp" android:textStyle="bold" android:textColor="#448aff"/>
        <com.appslayer.official.BatteryGraphView android:id="@+id/batteryGraph" android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/batteryHistorySummary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp" android:textColor="#9aa0a6"/>
        <TextView android:id="@+id/batteryHistoryHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="13sp" android:textColor="#ffb300" android:text="@string/battery_history_hint" android:visibility="gone"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/temp_sensors_title" android:textSize="16sp" android:textStyle="bold" android:textColor="#448aff"/>
        <TextView android:id="@+id/tempSensorList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp" android:textColor="#9aa0a6"/>
        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="#448aff" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/settings_title"/>
        <TextView android:textSize="16sp" android:textColor="#ffffff" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/transparency"/>
        <SeekBar android:id="@+id/seekTransparency" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:textSize="16sp" android:textColor="#ffffff" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/text_size"/>
        <SeekBar android:id="@+id/seekTextSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp"/>
        <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchSnapToBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/snap_to_bar"/>
        <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchClickThrough" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/click_through"/>
        <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchFullscreen" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/disable_fullscreen"/>
        <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchLandscape" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/disable_landscape"/>
        <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchDarkText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/dark_text"/>
        <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchTextShadow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/text_shadow"/>
        <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchBoot" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/start_on_boot"/>
        <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="#ffffff" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" android:text="@string/monitor_style_title"/>
        <RadioGroup android:id="@+id/radioMonitorStyle" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
            <RadioButton android:id="@+id/radioStyleClassic" android:textSize="16sp" android:textColor="#ffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="24dp" android:text="@string/monitor_style_classic"/>
            <RadioButton android:id="@+id/radioStyleMini" android:textSize="16sp" android:textColor="#ffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/monitor_style_mini"/>
        </RadioGroup>
        <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="#448aff" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/monitor_title"/>
        <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchCpu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/monitor_cpu"/>
        <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchTemp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/monitor_temp"/>
        <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchBattery" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/monitor_battery"/>
        <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchRam" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/monitor_ram"/>
        <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchBatteryCurrent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/monitor_current"/>
        <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchSignal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/monitor_signal"/>
        <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchFps" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/monitor_fps"/>
        <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchProcess" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" android:text="@string/monitor_process"/>
        <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="#448aff" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/fps_record_title"/>
        <Switch android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/switchRecordFps" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/record_fps"/>
        <TextView android:id="@+id/recordFpsStatus" android:textSize="13sp" android:textColor="#ffffff" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
        <TextView android:textSize="13sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:textColor="#9aa0a6" android:text="@string/record_fps_hint"/>
        <Button android:textSize="15sp" android:id="@+id/btnFpsSessions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/btn_fps_sessions"/>
        <Button android:textSize="15sp" android:layout_gravity="center_horizontal" android:id="@+id/buttonReset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" android:text="@string/reset_settings"/>
    </LinearLayout>
</ScrollView>
