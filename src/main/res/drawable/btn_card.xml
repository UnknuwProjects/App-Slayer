<?xml version="1.0" encoding="utf-8"?>
<!-- App-style button used on the card screens: a surface a step
lighter than the card itself, with the card's border and a
pressed state. Replaces the stock Holo button look, which the
light activity themes render as chunky grey blocks. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2c3134"/>
            <corners android:radius="8dp"/>
            <stroke android:width="1dp" android:color="#3a4043"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#24282b"/>
            <corners android:radius="8dp"/>
            <stroke android:width="1dp" android:color="#2c3134"/>
        </shape>
    </item>
</selector>
