<?xml version="1.0" encoding="utf-8"?>
<!-- Round thumb for the app's switches: a 24dp circle inside a
2dp inset, so the thumb box measures 28dp and the circle never
touches the pill's edge. Near-white when on, light grey when
off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset android:inset="2dp">
            <shape android:shape="oval">
                <size android:width="24dp" android:height="24dp"/>
                <solid android:color="#f5f7fa"/>
            </shape>
        </inset>
    </item>
    <item>
        <inset android:inset="2dp">
            <shape android:shape="oval">
                <size android:width="24dp" android:height="24dp"/>
                <solid android:color="#9aa5b1"/>
            </shape>
        </inset>
    </item>
</selector>
