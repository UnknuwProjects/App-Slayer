<?xml version="1.0" encoding="utf-8"?>
<!-- Pill track for the app's switches, drawn at a fixed 52x32dp
so the switch keeps a compact modern size. On uses the same
green as the charts and the battery bars (#4caf50); off is a
muted blue-grey that sits quietly on the cards. Replaces the
stock Holo track, whose wide bar shape showed through the old
tint-only styling. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="52dp" android:height="32dp"/>
            <corners android:radius="16dp"/>
            <solid android:color="#4caf50"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="52dp" android:height="32dp"/>
            <corners android:radius="16dp"/>
            <solid android:color="#39424e"/>
        </shape>
    </item>
</selector>
